---------------------------------------------------------------
---- ARITHMETIC
---------------------------------------------------------------

-- We can define the natural numbers as Peano numbers
data Nat = Z | S Nat

-- This will give the intuitive definition of addition
plus :: Nat -> Nat <-> Nat
plus Z     x = x
plus (S y) x =
  let x' = plus y x
  in  (S x')

dup :: a -> () <-> a
dup x () =  eq! x Eq

len :: [a] -> () <-> Nat
len (x:xs) () = 
  let len' = len xs ()
  in (S len')
len [] () = Z

-- Gotten from core rfun list.rfun file
reverse :: [a] <-> [a]
reverse xs =
  let l = len xs ()
      ([], ys, l') = move (xs, [], l)
      () = len! ys l'
  in ys

move :: [a] <-> [a]
move (x, l, Z) = (x, l, Z)
move ((x:xs), l, (S s)) =
  let (ys, ls, s') = move (xs, (x:l), s)
  in (ys, ls, (S s'))

delete :: Nat -> [a] <-> ([a], a)
delete Z (a:as) = (as, a)  
delete (S n) (a:as) =
  let (as', a') = delete n as
  in ((a:as'), a')

---------------------------------------------------------------
---- ACTORS
---------------------------------------------------------------

-- spawn :: (Actor a b c) -> b -> Action () Addr
-- send :: Action (Addr, a) (Addr, a)
-- `yield` and `: ()` are structure for defining an actor

data MsgType = MsgIn Nat | MsgOut Nat

-- Spawns an actor and sends it a number
$actorMain :: Actor () Nat
$actorMain : () = proc n -> do
      a <- spawn $orc -< n
      () <- send -< (a, (OSpawn []))
      yield -< Z

$orc : (Z, (OSpawn [])) = proc n -> do
  () <- send -< (self, (OSpawn []))
  yield $orc $orc -< n

$orc : (selfAddr, (OSpawn as)) = proc n -> do
  l <- arr (len as) -< ()
  case (eq n l) of 
    (Neq l') -> do
      a <- spawn $fib -< 1
      () <- send -< (selfAddr, (OSpawn (a:as)))
      yield $orc $orc -< n
    Eq -> do
      () <- arr (len! as) -< n
      a <- spawn $dispatcher -< (Z,[],as,[])
      () <- send -< (a, DStart)
      yield $orc $orc -< Z

$orc : (a, (ORes val)) = proc Z -> do
  val' <- arr (dup val) -< ()
  () <- send! -< (a, (ORes val))
  yield $orc1 $orc1 -< val'

$orc1 : (self, (ORes val))! = proc a -> do
  () <- send -< (a, DStart)
  yield $orc1 $orc1 -< val
  
$orc1 : (self, (ORes val)) = proc a -> do
  () <- send -< (a, DEnd)
  yield -< val


$dispatcher :: Actor FibAdd (Addr, Nat, [Addr])
$dispatcher : (fromAddr, DStart) = proc (Z,[],(a:as),ns) -> do
  () <- send (FAddNext Z) -< (a, (FAddNext Z))
  yield $dispatcher $dispatcher -< (fromAddr,[],as,ns)

$dispatcher : (fromAddr, DEnd) = proc (Z,das,as,ns) -> do
  case as of
    (a:as') -> do
      () <- send (FEnd) -< (a, FEnd)
      () <- send (DEndSend) -< (self, DEndSend)
      yield $dispatcher $dispatcher -< (fromAddr,das,as',ns)
    [] -> yield -< (fromAddr,das,[],ns)

$dispatcher : (self, DEndSend) = proc (a,das,as,ns) -> do
  case as of
    (a':as') -> do
      () <- send (FEnd) -< (a', FEnd)
      () <- send (DEndSend)-< (self, DEndSend)
      yield $dispatcher $dispatcher -< (a,das,as',ns)
    [] -> yield -< (a,das,[],ns)

$dispatcher : (fromAddr, (DAdd oldVal val)) = proc (a,das,as,ns) -> do
  case as of
    [] -> do
      () <- send (ORes _) -< (a, (ORes val))
      ns' <- arr reverse -< (oldVal:ns)
      yield $dispatcher $dispatcher -< (Z, (fromAddr:das), [], ns')
    as' -> do
      () <- send (DSend _ (S Z)) -< (self, (DSend val (S Z)))
      yield $dispatcher $dispatcher -< (a, (fromAddr:das), as', (oldVal:ns))

$dispatcher : (self, (DSend val i)) = proc (a,das,as,ns) -> do 
  l <- arr (len as) -< ()
  case (eq i l) of
    (Neq l') -> do
      () <- arr (len! as) -< l'
      (as', a') <- arr (delete i) -< as
      () <- send (FAdd _ _) -< (a', (FAdd val i))
      yield $dispatcher $dispatcher -< (a,das,as',ns)
    Eq -> do
      () <- arr (len! as) -< i
      (as', a') <- arr (delete Z) -< as
      () <- send (FAddNext _) -< (a', (FAddNext val))
      yield $dispatcher $dispatcher -< (a, das, as',ns)

$dispatcher : (fromAddr, (DAddAck val i)) = proc (a,das,as,ns) -> do
  as' <- arr (delete! i) -< (as, fromAddr)
  () <- send (DSend _ _) -< (self, (DSend val (S i)))
  yield $dispatcher $dispatcher -< (a, das, as',ns)

$fib :: Actor FibMsg Nat
$fib : (fromAddr, (FAdd val i)) = proc n -> do
  n' <- arr (plus val) -< n
  () <- send (DAddAck _ _) -< (fromAddr, (DAddAck val i))
  yield $fib $fib -< n'

$fib : (fromAddr, (FAddNext val)) = proc n -> do
  n' <- arr (dup n) -< ()
  () <- send (DAdd _ _) -< (fromAddr, (DAdd val n))
  yield $fib $fib -< n'

$fib : (fromAddr, FEnd) = proc (S Z) -> do
  yield -< fromAddr
