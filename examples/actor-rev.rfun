---------------------------------------------------------------
---- ARITHMETIC
---------------------------------------------------------------

-- We can define the natural numbers as Peano numbers
data Nat = Z | S Nat

-- This will give the intuitive definition of addition
plus :: Nat -> Nat <-> Nat
plus Z     x = x
plus (S y) x =
  let x' = plus y x
  in  (S x')

dup :: a -> () <-> a
dup x () =  eq! x Eq

---------------------------------------------------------------
---- ACTORS
---------------------------------------------------------------


-- spawn :: (Actor a b c) -> b -> Action () Addr
-- send :: Action (Addr, a) (Addr, a)
-- `yield` and `: ()` are structure for defining an actor

data MsgType = MsgIn Addr Nat | MsgOut Nat

-- Spawns an actor and sends it a number
$actorMain :: Actor () Nat
$actorMain : () = proc x -> do
  addr1 <- spawn $actor1 -< (S Z)
  addr2 <- spawn $actor2 -< addr1
  () <- send -< (addr1, (MsgIn addr2 x)) 
  yield -< Z 

-- Receives a natural and increments its state
$actor1 :: Actor MsgType Nat
$actor1 : (MsgIn addr x) = proc y -> do
  z <- arr (plus x) -< y
  () <- send -< (addr, (MsgOut z))
  yield $actor1 -< x
$actor1 : (MsgOut x) = proc y -> do
  yield -< (x, y)

$actor2 :: Actor MsgType Addr
$actor2 : (MsgOut x) = proc addr -> do
  addr1 <- arr (dup addr) -< () 
  () <- send! -< (addr, (MsgIn self x))
  yield $actor3 -< addr1
  
$actor3 :: Actor MsgType Addr
$actor3 : (MsgOut x) = proc addr -> do
  addr1 <- arr (dup addr) -< () 
  () <- send -< (addr, (MsgOut x))
  yield -< addr1

