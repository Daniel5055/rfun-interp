---------------------------------------------------------------
---- ARITHMETIC
---------------------------------------------------------------

-- We can define the natural numbers as Peano numbers
data Nat = Z | S Nat

-- This will give the intuitive definition of addition
plus :: Nat -> Nat <-> Nat
plus Z     x = x
plus (S y) x =
  let x' = plus y x
  in  (S x')

dup :: a -> () <-> a
dup x () =  eq! x Eq

---------------------------------------------------------------
---- ACTORS
---------------------------------------------------------------


-- spawn :: (Actor a b c) -> b -> Action () Addr
-- send :: Action (Addr, a) (Addr, a)
-- `yield` and `: ()` are structure for defining an actor

data MsgType = MsgIn Addr Nat | MsgOut Nat

-- Spawns an actor and sends it a number
$actorMain :: Actor () Nat
$actorMain : () = proc x -> do
  addr1 <- spawn $actor1 -< ((S Z), Z)
  addr2 <- spawn $actor2 -< addr1
  () <- send -< (addr2, (MsgIn x)) 
  yield -< Z 

-- Receives a natural and increments its state
$actor1 :: Actor MsgType Nat
$actor1 : (fromAddr, (MsgIn x)) = proc (y, addr) -> do
  z <- arr (plus x) -< y
  () <- send (MsgOut _) -< (fromAddr, (MsgOut z))
  yield $actor1 $actor1 -< (x, addr)
$actor1 : (fromAddr, (MsgOut x)) = proc (y, Z) -> do
  z <- arr (plus x) -< y
  yield -< (z, fromAddr)

$actor2 :: Actor MsgType Addr
$actor2 : (fromAddr, (MsgIn x)) = proc addr -> do
  () <- send -< (addr, (MsgIn x))
  yield $actor2 -< fromAddr

$actor2 : (fromAddr, (MsgOut x)) = proc addr -> do
  () <- send! -< (fromAddr, (MsgOut x))
  yield $actor3 -< addr


$actor3 :: Actor MsgType Addr
$actor3 : (fromAddr, (MsgIn x)) = proc addr -> do
  () <- send -< (fromAddr, (MsgOut x))
  yield -< addr
