cabal-version:       3.0
-- Initial rfun-interp.cabal generated by cabal init.  For further 
-- documentation, see http://haskell.org/cabal/users-guide/
name:                rfun-interp
version:             0.1.0.0
synopsis:            Interpreter for the reversible functional language rFun
-- description:         
author:              Michael Kirkedal Thomsen
maintainer:          kirkedal@acm.org
-- copyright:           
category:            Language
build-type:          Simple

common deps
  other-modules:      Ast,
                      Parser,
                      PrettyPrinter,
                      Interp,
                      TypeCheck,
                      Core.Ast,
                      Core.Interp,
                      Core.Preparse
  build-depends:      base >=4.18 && <5,
                      megaparsec >= 9.8.2,
                      parsec == 3.1.16.1,
                      parser-combinators >= 1.3.1,
                      containers == 0.6.7,
                      pretty == 1.1.3.6,
                      mtl == 2.3.2
  hs-source-dirs: src

executable actor
  import: deps
  other-modules:      Actor.Ast,
                      Actor.Parser

  ghc-options:      -main-is MainActor
  main-is: MainActor.hs

executable rfun
  import: deps
  ghc-options:      -main-is MainRFun
  main-is: MainRFun.hs

executable core
  import: deps
  other-modules:      Core.Parser,
                      Core.RFun2Prog

  ghc-options:      -main-is MainCore
  main-is: MainCore.hs